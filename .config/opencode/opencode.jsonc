{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "primary",
  "subagent_depth": 2,
  "permission": {
    // default
    "*": "ask",

    // denylist
    "todowrite": "deny",

    // allowlist
    "edit": "allow",
    "task": "allow",
    "skill": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "bash": {
      "git status *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git log *": "allow",
      "git stash list *": "allow",
      "git stash show *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "find *": "allow",
      "sort *": "allow",
      "ls *": "allow",
      "wc *": "allow",
      "pwd *": "allow",
      "true *": "allow",
      "false *": "allow",
      "file *": "allow"
    }
  },
  "agent": {
    // configure custom agents
    "primary-agent": {
      "model": "zai-coding-plan/glm-5.3",
      "variant": "max"
    },
    "smart-subagent": {
      "model": "opencode-go/kimi-k3",
      "variant": "max"
    },
    "balanced-subagent": {
      "model": "opencode-go/deepseek-v4-pro",
      "variant": "max"
    },
    "fast-subagent": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    },

    // disable built-in agents
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "scout": {
      "disable": true
    }
  }
}
