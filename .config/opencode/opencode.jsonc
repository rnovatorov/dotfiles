{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "main",
  "subagent_depth": 2,
  "permission": {
    // ask by default
    "*": "ask",

    // denylist
    "todowrite": "deny",

    // allowlist
    "external_directory": {
      "/tmp/*": "allow",
      "/home/*/code/*": "allow",
      "/home/*/.config/opencode/skills/*": "allow"
    },
    "edit": "allow",
    "task": "allow",
    "skill": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "bash": {
      // git
      "git status *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git log *": "allow",
      "git tag -l *": "allow",
      "git stash list *": "allow",
      "git stash show *": "allow",
      "git describe *": "allow",
      "git clone *": "allow",
      // opencode
      "opencode --version": "allow",
      // pdfs
      "pdfinfo *": "allow",
      "pdftotext *": "allow",
      // other stuff
      "sleep *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "find *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "ls *": "allow",
      "wc *": "allow",
      "pwd *": "allow",
      "true *": "allow",
      "false *": "allow",
      "file *": "allow",
      "echo *": "allow",
      "which *": "allow",
      "tr *": "allow",
      "man *": "allow",
      "col *": "allow",
      "strings *": "allow",
      "printf *": "allow"
    }
  },
  "agent": {
    // disable built-in agents
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "scout": {
      "disable": true
    }
  }
}
